### Email Service API Testing
### Base URL: http://localhost:3002/api/emails

### Variables
@baseUrl = http://localhost:3002/api/emails
@userId = temp-user-id

################################################################################
### 1. Test SMTP/IMAP Connection (IMPORTANT: Test this first!)
################################################################################
POST {{baseUrl}}/accounts/test-connection
Content-Type: application/json

{
  "email": "your-email@gmail.com",
  "password": "your-app-password",
  "smtp": {
    "host": "smtp.gmail.com",
    "port": 587,
    "secure": false
  },
  "imap": {
    "host": "imap.gmail.com",
    "port": 993,
    "tls": true
  }
}

################################################################################
### 2. Create Email Account (After testing connection)
################################################################################
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "email": "your-email@gmail.com",
  "displayName": "My Gmail Account",
  "username": "your-email@gmail.com",
  "password": "your-app-password",
  "smtpConfig": {
    "host": "smtp.gmail.com",
    "port": 587,
    "secure": false
  },
  "imapConfig": {
    "host": "imap.gmail.com",
    "port": 993,
    "tls": true
  }
}

### Store the returned emailAccountId in a variable
@emailAccountId = <paste-email-account-id-here>

################################################################################
### 3. Get All Email Accounts
################################################################################
GET {{baseUrl}}/accounts
Content-Type: application/json

################################################################################
### 4. Get Email Account by ID
################################################################################
GET {{baseUrl}}/accounts/{{emailAccountId}}
Content-Type: application/json

################################################################################
### 5. Initialize Folders for Email Account
################################################################################
POST {{baseUrl}}/folders/initialize/{{emailAccountId}}
Content-Type: application/json

################################################################################
### 6. Get All Folders for Email Account
################################################################################
GET {{baseUrl}}/folders?emailAccountId={{emailAccountId}}
Content-Type: application/json

### Store SENT and DRAFTS folder IDs
@sentFolderId = <paste-sent-folder-id-here>
@draftsFolderId = <paste-drafts-folder-id-here>
@inboxFolderId = <paste-inbox-folder-id-here>

################################################################################
### 7. Create Custom Folder
################################################################################
POST {{baseUrl}}/folders?emailAccountId={{emailAccountId}}
Content-Type: application/json

{
  "name": "Important",
  "icon": "⭐",
  "color": "#FFD700"
}

################################################################################
### 8. Send Email
################################################################################
POST {{baseUrl}}/emails/send
Content-Type: application/json

{
  "emailAccountId": "{{emailAccountId}}",
  "from": {
    "email": "your-email@gmail.com",
    "name": "Your Name"
  },
  "to": [
    {
      "email": "recipient@example.com",
      "name": "Recipient Name"
    }
  ],
  "subject": "Test Email from CMS Email System",
  "textBody": "This is a test email sent from the CMS Email System.",
  "htmlBody": "<p>This is a <strong>test email</strong> sent from the CMS Email System.</p>"
}

### Store the returned emailId
@sentEmailId = <paste-email-id-here>

################################################################################
### 9. Save Draft Email
################################################################################
POST {{baseUrl}}/emails/drafts
Content-Type: application/json

{
  "emailAccountId": "{{emailAccountId}}",
  "from": {
    "email": "your-email@gmail.com",
    "name": "Your Name"
  },
  "to": [
    {
      "email": "someone@example.com"
    }
  ],
  "subject": "Draft Email",
  "textBody": "This is a draft email."
}

### Store the returned emailId
@draftEmailId = <paste-draft-email-id-here>

################################################################################
### 10. List All Emails
################################################################################
GET {{baseUrl}}/emails?page=1&limit=20
Content-Type: application/json

################################################################################
### 11. List Emails by Folder
################################################################################
GET {{baseUrl}}/emails?folderId={{sentFolderId}}&page=1&limit=10
Content-Type: application/json

################################################################################
### 12. List Unread Emails
################################################################################
GET {{baseUrl}}/emails?isRead=false&page=1&limit=10
Content-Type: application/json

################################################################################
### 13. List Starred Emails
################################################################################
GET {{baseUrl}}/emails?isStarred=true&page=1&limit=10
Content-Type: application/json

################################################################################
### 14. Search Emails (Full-text search)
################################################################################
GET {{baseUrl}}/emails?searchQuery=test&page=1&limit=10
Content-Type: application/json

################################################################################
### 15. Get Email by ID
################################################################################
GET {{baseUrl}}/emails/{{sentEmailId}}
Content-Type: application/json

################################################################################
### 16. Mark Email as Read
################################################################################
PATCH {{baseUrl}}/emails/{{sentEmailId}}/read?isRead=true
Content-Type: application/json

################################################################################
### 17. Mark Email as Unread
################################################################################
PATCH {{baseUrl}}/emails/{{sentEmailId}}/read?isRead=false
Content-Type: application/json

################################################################################
### 18. Toggle Star on Email
################################################################################
PATCH {{baseUrl}}/emails/{{sentEmailId}}/star
Content-Type: application/json

################################################################################
### 19. Move Email to Another Folder
################################################################################
PATCH {{baseUrl}}/emails/{{sentEmailId}}/move?folderId={{inboxFolderId}}
Content-Type: application/json

################################################################################
### 20. Update Email Account
################################################################################
PATCH {{baseUrl}}/accounts/{{emailAccountId}}
Content-Type: application/json

{
  "displayName": "Updated Gmail Account Name"
}

################################################################################
### 21. Delete Email Account
################################################################################
DELETE {{baseUrl}}/accounts/{{emailAccountId}}
Content-Type: application/json

################################################################################
### NOTES FOR GMAIL USERS:
################################################################################
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Generate an App Password:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select "Mail" and your device
#    - Copy the 16-character password
# 3. Use the App Password (not your regular password) in the API requests
# 4. SMTP Settings for Gmail:
#    - Host: smtp.gmail.com
#    - Port: 587 (TLS) or 465 (SSL)
#    - Secure: false for 587, true for 465
# 5. IMAP Settings for Gmail:
#    - Host: imap.gmail.com
#    - Port: 993
#    - TLS: true
################################################################################
